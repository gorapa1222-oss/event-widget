h.naver.com/search.naver?query=%EA%B2%BD%EB%82%A8%EA%B3%A0%EC%84%B1%EA%B3%B5%EB%A3%A1%EC%84%B8%EA%B3%84%EC%97%91%EC%8A%A4%ED%8F%AC","tel":"055-670-7491~3","lat":35.0533072967,"lng":128.3915143393,"added":""},{"id":"C401650","src":"문화포털","cat":"전시","genre":"전시","title":"장건율·정진경 《달과 포도 Moon and Grapes》","start":"20261001","end":"20261031","place":"프로젝트 아이","addr":"경상남도 창원시 성산구 외동반림로262번길 13 용호동 44-5","region":"gyeongnam","price":"무료","priceText":"무료","img":"http://www.culture.go.kr/upload/ucms/oneCltInfo/2026/202610/34f2317b4e414bdfab0e5f5ac79e1fb5.jpg","imgs":[],"intro":"","cast":"","time":"","age":"","runtime":"","url":"https://archivist.kr/exi?m=gov&i=1791410659","tel":"+82 (0)10-7109-0592, contact.aaay@gmail.com","lat":35.2395618013644,"lng":128.681686821485,"introAuto":true,"added":""},{"id":"C401437","src":"문화포털","cat":"전시","genre":"전시","title":"《다정한 영토》","start":"20261008","end":"20261122","place":"이성자미술관","addr":"경상남도 진주시 에나로128번길 14 이성자미술관","region":"gyeongnam","price":"1,000원~","priceText":"성인 2,000원 / 청소년, 군인 1,000원 / 어린이 500원","img":"http://www.culture.go.kr/upload/ucms/oneCltInfo/2026/202610/c01458a2a82740cb84b3c26341718f74.png","imgs":[],"intro":"","cast":"","time":"","age":"","runtime":"","url":"https://www.jinju.go.kr/rheesjmuseum/","tel":"진주시립이성자미술관 055-749-3661","lat":35.17587785343491,"lng":128.1427561387228,"introAuto":true,"added":""},{"id":"T3019716","src":"관광공사","cat":"축제","genre":"축제","title":"대장경기록문화축제","start":"20261009","end":"20261101","place":"합천군 대장경테마파크","addr":"경상남도 합천군 가야면 가야산로 1160 대장경테마파크","region":"gyeongnam","price":"입장료 유료(체험료 별도)","priceText":"입장료 유료(체험료 별도)","img":"https://tong.visitkorea.or.kr/cms/resource/49/4122749_image2_1.jpg","imgs":[],"intro":"올해 축제는 '꽃길따라 합천 한바퀴'란 주제로 합천의 주요 명소를 가을꽃 조형물로 광장에 표현하여 관람객들이 여행을 떠나는 컨셉으로 즐길 수 있도록 하였다. 여행 컨셉은 총4단계로 구성하였는데 1단계(여행출발역) : 별쿵이와 함께하는 합천여행 / 2단계(여행정거장) : 합천의 명소를 정거장으로 표현하여 합천의 특별한 매력을 느낄 수 있다. / 3단계(꽃길 여행로) : 알록달록 피어난 가을꽃을 따라 걸으며 아름다운 풍경 속에서 나만의 기록을 남겨보자. / 4단계(여행 종착역) : 꽃길 끝에서 만나는 아늑