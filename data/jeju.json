 그 미학을 제시하고자 한다.","cast":"","time":"- 8월/9월 10:00~20:00- 10월/11월 10:00~18:00","age":"전 연령","runtime":"","url":"http://www.jejubiennale.org/","tel":"064-710-4300","lat":33.4525500193,"lng":126.489686091,"added":""},{"id":"C402469","src":"문화포털","cat":"전시","genre":"전시","title":"독립기념관 현충시설 순회전","start":"20261015","end":"20261130","place":"제주항일기념관","addr":"제주특별자치도 제주시 조천읍 신북로 303 제주항일기념관","region":"jeju","price":"무료","priceText":"무료","img":"http://www.culture.go.kr/upload/rdf/26/10/rdf_2026101521174143794.jpg","imgs":[],"intro":"","cast":"","time":"","age":"","runtime":"","url":"https://www.jeju.go.kr/hangil/exhibit/hall3.htm?act=view&seq=2037681","tel":"064-783-2008","lat":33.5416249934,"lng":126.642827155,"introAuto":true,"added":"20261016"},{"id":"C402635","src":"문화포털","cat":"체험","genre":"체험","title":"2026 예술공간 이아 하반기 예술교육 프로그램 「이아로 잇는 삶」","start":"20261103","end":"20261126","place":"","addr":"","region":"jeju","price":"","priceText":"","img":"http://www.culture.go.kr/upload/ucms/oneCltInfo/2026/202610/80e1e1e9f15e406382b5b91c3a301a8a.png","imgs":[],"intro":"","cast":"","time":"","age":"","runtime":"","url":"https://www.jfac.kr/notification/notice/20510?page=1","tel":"064-800-9146","lat":null,"lng":null,"introAuto":true,"added":"20261019"},{"id":"C406723","src":"문화포털","cat":"공연","genre":"연극","title":"바보 히어로","start":"20261104","end":"20261115","place":"제주특별자치도문예회관","addr":"제주특별자치도 제주시 동광로 69 제주특별자치도 문예회관","region":"jeju","price":"10,000원","priceText":"전석 10,000원","img":"http://www.culture.go.kr/upload/rdf/26/11/rdf_2026110621174752526.png","imgs":[],"intro":"","cast":"","time":"","age":"","runtime":"","url":"https://www.eticketjeju.co.kr/concert/detail.do?ceSeq=235509","tel":"010-2689-3152, 064-710-7642","lat":33.50460332884994,"lng":126.53520859537419,"introAuto":true,"added":"20261114"},{"id":"C404537","src":"문화포털","cat":"공연","genre":"연극","title":"타인의 삶","start":"20261113","end":"20261114","place":"제주아트센터 대극장","addr":"제주특별자치도 제주시 오남로 231 제주아트센터","region":"jeju","pri